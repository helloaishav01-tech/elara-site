#!/usr/bin/env python3
\"\"\"Build ELARA PROJECT_REPORT.pdf with a botanical, editorial style.\"\"\"
import markdown
from weasyprint import HTML, CSS
from pathlib import Path

ROOT = Path(\"/app/elara-docs\")
md_text = (ROOT / \"PROJECT_REPORT.md\").read_text(encoding=\"utf-8\")

html_body = markdown.markdown(
    md_text,
    extensions=[\"extra\", \"tables\", \"toc\", \"sane_lists\", \"fenced_code\"],
)

css = \"\"\"
@page {
  size: A4;
  margin: 22mm 20mm 22mm 20mm;
  @bottom-center {
    content: \"ELARA · Atelier of Luxury Footwear  ·  page \" counter(page) \" of \" counter(pages);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 9pt;
    color: #9c9f69;
  }
}
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Manrope:wght@300;400;500;600;700&display=swap');
* { box-sizing: border-box; }
body {
  font-family: 'Manrope', system-ui, sans-serif;
  font-size: 10.5pt;
  line-height: 1.65;
  color: #364023;
  background: #faf6f0;
}
h1, h2, h3, h4 {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 400;
  color: #364023;
  letter-spacing: -0.01em;
}
h1 {
  font-size: 32pt;
  font-style: italic;
  margin: 0 0 4pt 0;
  border-bottom: 0.5pt solid #c9a96e;
  padding-bottom: 8pt;
  page-break-after: avoid;
}
h2 {
  font-size: 18pt;
  margin: 26pt 0 8pt 0;
  color: #6a823e;
  page-break-after: avoid;
}
h3 {
  font-size: 13pt;
  margin: 18pt 0 4pt 0;
  color: #364023;
  font-weight: 500;
  page-break-after: avoid;
}
h4 {
  font-size: 11pt;
  margin: 12pt 0 2pt 0;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: #c9a96e;
  font-family: 'Manrope', sans-serif;
  font-weight: 600;
}
p { margin: 6pt 0; }
em, i { color: #6a823e; }
strong { color: #364023; font-weight: 600; }
a { color: #c9a96e; text-decoration: none; }
hr {
  border: none;
  border-top: 0.4pt dashed #e6b1c4;
  margin: 18pt 0;
}
code {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 9pt;
  background: #f0ece4;
  color: #364023;
  padding: 1pt 4pt;
  border-radius: 2pt;
}
pre {
  background: #364023;
  color: #faf6f0;
  padding: 10pt 12pt;
  border-radius: 3pt;
  font-size: 8.5pt;
  line-height: 1.5;
  overflow-x: auto;
  page-break-inside: avoid;
}
pre code { background: transparent; color: #faf6f0; padding: 0; }
table {
  width: 100%;
  border-collapse: collapse;
  margin: 8pt 0 14pt 0;
  font-size: 9.5pt;
  page-break-inside: avoid;
}
th {
  background: #364023;
  color: #faf6f0;
  text-align: left;
  padding: 6pt 8pt;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 8.5pt;
  font-family: 'Manrope', sans-serif;
}
td {
  padding: 5pt 8pt;
  border-bottom: 0.3pt solid #e6b1c4;
  vertical-align: top;
}
tr:nth-child(even) td { background: #fbf3ee; }
ul, ol { margin: 6pt 0 10pt 18pt; padding: 0; }
li { margin: 2pt 0; }
blockquote {
  border-left: 2pt solid #c9a96e;
  margin: 10pt 0;
  padding: 4pt 12pt;
  font-style: italic;
  color: #6a823e;
  background: #fbf3ee;
}
.tagline {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  color: #c9a96e;
  font-size: 13pt;
}
\"\"\"

# Prepend a cover-page header
cover_html = \"\"\"
<div style=\"text-align:center; padding-top: 40pt; padding-bottom: 30pt;\">
  <div style=\"font-family:'Cormorant Garamond', serif; font-size: 11pt; letter-spacing: 0.5em; color:#c9a96e; text-transform: uppercase;\">A T E L I E R &nbsp; · &nbsp; 2 0 2 6</div>
  <div style=\"font-family:'Cormorant Garamond', serif; font-style: italic; font-size: 64pt; color:#364023; margin: 8pt 0 4pt 0;\">Elara</div>
  <div style=\"font-family:'Cormorant Garamond', serif; font-style: italic; font-size: 16pt; color:#6a823e; margin-bottom: 24pt;\">Where flowers bloom underfoot.</div>
  <div style=\"font-family:'Manrope', sans-serif; font-size: 9pt; letter-spacing: 0.3em; text-transform: uppercase; color:#9c9f69;\">Full-Stack E-Commerce Case Study</div>
  <hr style=\"width: 80pt; border:none; border-top: 0.6pt solid #c9a96e; margin: 14pt auto;\">
  <div style=\"font-family:'Manrope', sans-serif; font-size: 10pt; color:#364023;\">Aisha V.</div>
</div>
<div style=\"page-break-after: always;\"></div>
\"\"\"

full_html = f\"<html><head><meta charset='utf-8'><title>ELARA Project Report</title></head><body>{cover_html}{html_body}</body></html>\"

out_path = ROOT / \"PROJECT_REPORT.pdf\"
HTML(string=full_html).write_pdf(out_path, stylesheets=[CSS(string=css)])
print(f\"Wrote {out_path} ({out_path.stat().st_size // 1024} KB)\")
